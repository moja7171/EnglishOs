APP_NAME="English OS"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://englishos.growwise.ir

# Optional — sets the admin@englishos.local account's password (see
# public/deploy.php, which creates/syncs that account on every
# deploy). Left unset, it falls back to a fixed default — set this to
# override it with something private, since that default is visible in
# this public repo's history.
ADMIN_PASSWORD=

# Optional — lets public/deploy.php be triggered directly by visiting
# it in a browser (?token=<this value>), not just by the internal
# .cpanel.yml curl (REMOTE_ADDR === 127.0.0.1). Useful when that
# internal trigger can't be confirmed working and there's no
# SSH/Terminal access to check why. Leave unset to disable this path
# entirely — deploy.php still works via the internal curl either way.
DEPLOY_TOKEN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=english_os
DB_USERNAME=english_os
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Ordered model chains, best first (comma separated; "model:level" sets a thinking level).
# Empty = the GEMINI_MODEL + GEMINI_FALLBACK_MODEL pair above. Quota is per model, so keep
# the first entries of the two lists different.
GEMINI_CHAT_MODELS=
GEMINI_JUDGE_MODELS=
# A learner never waits long: seconds per attempt, models tried per request, total seconds.
GEMINI_ATTEMPT_TIMEOUT=10
GEMINI_MAX_ATTEMPTS=3
GEMINI_TOTAL_BUDGET=20

GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_FALLBACK_MODEL=whisper-large-v3
# Ordered Whisper chain, best first (comma separated). Empty = the two models above.
GROQ_WHISPER_MODELS=
GROQ_ATTEMPT_TIMEOUT=12
GROQ_MAX_ATTEMPTS=3
GROQ_TOTAL_BUDGET=25

# Optional — powers Vocabulary Builder's picture flashcards. Get a free key
# at https://www.pexels.com/api/ (instant approval). Left blank, that
# feature just silently shows no images; nothing else depends on it.
PEXELS_API_KEY=

# Optional — routes Gemini/Groq/Pexels calls through a small HTTP relay
# instead of connecting directly, for when this server can't reach them
# itself (filtered network) but another machine can. Two relay slots are
# kept side by side — AI_PROXY_TARGET picks which one is live ("vps" or
# "local"). Switch with `php artisan ai:relay-use vps|local` (see
# App\Console\Commands\AiRelayUse), the profile page's admin-only "AI
# Relay" tab, or the token-gated /_diag/ai-relay-use route on a host with
# no SSH/terminal. See scripts/ai-relay.py (also scripts/ai-relay.js, a
# Node port) for the relay script and scripts/vps-relay-setup.sh for a
# real VPS. *_URL is the relay's public URL (a tunnel to wherever it's
# running), *_SECRET must match that relay's RELAY_SECRET. Both slots left
# blank, every call connects directly — no behavior change from before
# this existed.
AI_PROXY_TARGET=vps

AI_PROXY_URL_VPS=
AI_PROXY_SECRET_VPS=

AI_PROXY_URL_LOCAL=
AI_PROXY_SECRET_LOCAL=

# Web Push (phone notifications). Generate a P-256 key pair once and keep it
# stable — rotating it invalidates every saved subscription. VAPID_SUBJECT
# must be a real https:// URL or mailto: address (Apple rejects others).
# WEBPUSH_PROXY is optional: an outbound HTTP(S) proxy for servers that can't
# reach the browsers' push services (FCM, Apple, Mozilla) directly.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEBPUSH_PROXY=

VITE_APP_NAME="${APP_NAME}"
